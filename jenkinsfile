pipeline {
    agent any

    environment {
        APP_NAME   = 'buy-01'
        COMPOSE    = 'docker compose'
        DEPLOY_DIR = '/opt/buy-01'
        EMAIL      = 'louhabali@gmail.com'
    }

    triggers {
        githubPush()
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Docker Check') {
            steps {
                sh '''
                    whoami
                    ${COMPOSE} version
                    docker ps
                '''
            }
        }

        stage('Build Images & Test Frontend') {
            steps {
                sh '${COMPOSE} build'
            }
        }

        stage('Start Infrastructure') {
            steps {
                sh '${COMPOSE} up -d mongodb redis kafka'
            }
        }

        stage('Start Application') {
            steps {
                sh '''
                    ${COMPOSE} up -d \
                        user-service \
                        product-service \
                        media-service \
                        gateway \
                        frontend
                '''
            }
        }

        stage('Run Backend Tests') {
            steps {
                // Running each test block independently so working directories don't pollute subsequent steps
                sh '(cd gateway_service && ./mvnw test)'
                sh '(cd user_service && ./mvnw test)'
                sh '(cd product_service && ./mvnw test)'
                sh '(cd media_service && ./mvnw test)'
            }
        }

    
        stage('Deploy') {
            steps {
                sh """
                    mkdir -p ${DEPLOY_DIR}
                    cp docker-compose.yml ${DEPLOY_DIR}/
                    cp .env ${DEPLOY_DIR}/ || true
                    
                    cd ${DEPLOY_DIR}
                    ${COMPOSE} up -d --remove-orphans
                """
            }
        }
    }

   post {
        success {
            echo 'Deployment successful'
        }

        failure {
            echo 'Deployment failed'
        }

        always {
            sh '${COMPOSE} down --remove-orphans || true'
            cleanWs()
        }
    }
}