pipeline {
    agent any

    environment {
        APP_NAME   = 'buy-01'
        COMPOSE    = 'docker compose'
        DEPLOY_DIR = '/opt/buy-01'
        EMAIL      = 'team@example.com'
    }

    triggers {
        githubPush()
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Docker Check') {
            steps {
                sh '''
                    whoami
                    ${COMPOSE} version
                    docker ps
                '''
            }
        }

        stage('Build Images') {
            steps {
                sh '${COMPOSE} build'
            }
        }

        stage('Start Infrastructure') {
            steps {
                sh '${COMPOSE} up -d mongodb redis kafka'
            }
        }

        stage('Start Application') {
            steps {
                // Fixed container names: gateway and frontend
                sh '''
                    ${COMPOSE} up -d \
                        user-service \
                        product-service \
                        media-service \
                        gateway \
                        frontend
                '''
            }
        }

        stage('Run Backend Tests') {
            steps {
                sh '''
                    cd gateway_service && ./mvnw test
                    cd ../user_service && ./mvnw test
                    cd ../product_service && ./mvnw test
                    cd ../media_service && ./mvnw test
                '''
            }
        }

        stage('Run Frontend Tests') {
            steps {
                // Fixed: exec into 'frontend' with -T flag (non-interactive CI mode)
                sh '${COMPOSE} exec -T frontend npm test -- --watch=false --browsers=ChromeHeadless'
            }
        }

        stage('Health Check') {
            steps {
                sh '''
                    sleep 20
                    curl --fail http://localhost:8089/actuator/health
                '''
            }
        }

        stage('Deploy') {
            steps {
                sh """
                    mkdir -p ${DEPLOY_DIR}
                    cp docker-compose.yml ${DEPLOY_DIR}/
                    cp .env ${DEPLOY_DIR}/ || true
                    
                    cd ${DEPLOY_DIR}
                    ${COMPOSE} up -d --remove-orphans
                """
            }
        }
    }

    post {
        success {
            echo 'Deployment successful'
            mail(
                to: EMAIL,
                subject: "SUCCESS ${JOB_NAME} #${BUILD_NUMBER}",
                body: "Build succeeded.\n${BUILD_URL}"
            )
        }

        failure {
            echo 'Deployment failed'
            mail(
                to: EMAIL,
                subject: "FAILED ${JOB_NAME} #${BUILD_NUMBER}",
                body: "Build failed.\n${BUILD_URL}"
            )
        }

        always {
            // Clean workspace artifacts without killing the deployed stack
            cleanWs()
        }
    }
}