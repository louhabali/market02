pipeline {
    agent any

    environment {
        APP_NAME   = '01e_com'
        COMPOSE    = 'docker compose -p 01e_com'
        DEPLOY_DIR = '/opt/01e_com'
        EMAIL      = 'louhabali@gmail.com'
    }

    triggers {
        githubPush()
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Docker Check') {
            steps {
                sh '''
                    whoami
                    ${COMPOSE} version
                    docker ps
                '''
            }
        }

        stage('Build Images & Test Frontend') {
            steps {
                // Frontend Karma/Jasmine tests execute inside the multi-stage Dockerfile during build
                sh '${COMPOSE} build'
            }
        }

        stage('Start Test Infrastructure') {
            steps {
                sh '${COMPOSE} up -d mongodb redis kafka'
            }
        }

        stage('Start Test Application') {
            steps {
                sh '''
                    ${COMPOSE} up -d \
                        user-service \
                        product-service \
                        media-service \
                        gateway \
                        frontend
                '''
            }
        }

        stage('Run Backend Tests') {
            steps {
                sh '(cd gateway_service && ./mvnw test)'
                sh '(cd user_service && ./mvnw test)'
                sh '(cd product_service && ./mvnw test)'
            }
            post {
                always {
                    // Publishes JUnit test results directly into the Jenkins UI
                    junit allowEmptyResults: true, testResults: '**/target/surefire-reports/*.xml'
                }
            }
        }

   stage('Health Check') {
            steps {
                sh '''
                    # Retries up to 12 times (60 seconds total timeout) using BusyBox wget
                    for i in $(seq 1 12); do
                        if ${COMPOSE} exec -T gateway wget -q --spider http://localhost:8089/actuator/health; then
                            echo "Gateway is healthy!"
                            exit 0
                        fi
                        echo "Waiting for Gateway service to become healthy... (attempt $i/12)"
                        sleep 5
                    done
                    
                    echo "Health check failed after 60 seconds."
                    exit 1
                '''
            }
        }
        stage('Deploy') {
            steps {
                sh """
                    mkdir -p ${DEPLOY_DIR}
                    cp docker-compose.yml ${DEPLOY_DIR}/
                    cp .env ${DEPLOY_DIR}/ || true
                    
                    cd ${DEPLOY_DIR}
                    ${COMPOSE} up -d --no-build --remove-orphans
                """
            }
        }
    }

    post {
        success {
            echo 'Deployment successful'
            // Sends success notification (Configure Jenkins SMTP under System Settings)
            mail(
                to: env.EMAIL,
                subject: "SUCCESS: ${env.JOB_NAME} [Build #${env.BUILD_NUMBER}]",
                body: "Pipeline completed successfully and deployed to ${env.DEPLOY_DIR}.\n\nDetails: ${env.BUILD_URL}"
            )
        }

        failure {
            echo 'Deployment failed - Initiating Rollback...'
            
            // Automated Rollback Strategy: Restarts the last known stable state in production
            sh """
                if [ -d "${env.DEPLOY_DIR}" ]; then
                    echo "Executing rollback in ${env.DEPLOY_DIR}..."
                    cd ${env.DEPLOY_DIR}
                    ${env.COMPOSE} up -d --remove-orphans || true
                fi
            """

            // Sends failure notification with build logs link
            mail(
                to: env.EMAIL,
                subject: "FAILURE: ${env.JOB_NAME} [Build #${env.BUILD_NUMBER}]",
                body: "Pipeline or Deployment failed. Automated rollback attempted.\n\nCheck logs at: ${env.BUILD_URL}"
            )
        }

        always {
            // Cleans up CI workspace test containers without touching the production deployment
            sh '${COMPOSE} down --remove-orphans || true'
            cleanWs()
        }
    }
}