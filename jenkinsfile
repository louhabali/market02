pipeline {
    agent any

    environment {
        APP_NAME = 'buy-01'
        COMPOSE = 'docker compose'
        DEPLOY_DIR = '/opt/buy-01'
        EMAIL = 'team@example.com'
    }

    triggers {
        githubPush()
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Images') {
            steps {
                sh '''
                    ${COMPOSE} build
                '''
            }
        }

        stage('Start Infrastructure') {
            steps {
                sh '''
                    ${COMPOSE} up -d mongodb redis kafka
                '''
            }
        }

        stage('Start Application') {
            steps {
                sh '''
                    ${COMPOSE} up -d \
                        user-service \
                        product-service \
                        media-service \
                        gateway
                '''
            }
        }

        stage('Run Backend Tests') {
            steps {
                sh '''
                    docker compose exec gateway-service ./mvnw test
                    docker compose exec user-service ./mvnw test
                    docker compose exec product-service ./mvnw test
                    docker compose exec media-service ./mvnw test
                '''
            }
        }

        stage('Run Frontend Tests') {
            steps {
                sh '''
                    docker compose up -d frontend

                    docker compose exec angular-client npm test -- --watch=false --browsers=ChromeHeadless
                '''
            }
        }

        stage('Health Check') {
            steps {
                sh '''
                    sleep 20

                    curl --fail http://localhost:8089/actuator/health
                '''
            }
        }

        stage('Deploy') {
            steps {
                sh """
                    mkdir -p ${DEPLOY_DIR}

                    cp docker-compose.yml ${DEPLOY_DIR}

                    cp .env ${DEPLOY_DIR} || true

                    cd ${DEPLOY_DIR}

                    docker compose down

                    docker compose up -d
                """
            }
        }
    }

    post {
        success {
            echo 'Deployment successful'

            mail(
                to: EMAIL,
                subject: "SUCCESS ${JOB_NAME} #${BUILD_NUMBER}",
                body: "Build succeeded.\n${BUILD_URL}"
            )
        }

        failure {
            echo 'Deployment failed'

            mail(
                to: EMAIL,
                subject: "FAILED ${JOB_NAME} #${BUILD_NUMBER}",
                body: "Build failed.\n${BUILD_URL}"
            )
        }

        always {
            sh '''
                docker compose down -v || true
            '''

            cleanWs()
        }
    }
}
