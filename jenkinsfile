pipeline {
    agent any

    environment {
        APP_NAME   = '01e_com'
        COMPOSE    = 'docker compose -p 01e_com'
        DEPLOY_DIR = '/opt/01e_com'
        EMAIL      = 'louhabali@gmail.com'
    }

    triggers {
        githubPush()
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Docker Check') {
            steps {
                sh '''
                    whoami
                    ${COMPOSE} version
                    docker ps
                '''
            }
        }

        stage('Build & Test Frontend') {
            steps {
                // Frontend Karma/Jasmine unit tests run inside Dockerfile multi-stage build
                sh '${COMPOSE} build'
            }
        }

        stage('Start Test Infrastructure') {
            steps {
                sh '${COMPOSE} up -d mongodb redis kafka'
            }
        }

        stage('Start Test Services') {
            steps {
                sh '''
                    ${COMPOSE} up -d \
                        user-service \
                        product-service \
                        media-service \
                        gateway \
                        frontend
                '''
            }
        }

        stage('Run Backend Unit Tests') {
            steps {
                sh '(cd gateway_service && ./mvnw test)'
                sh '(cd user_service && ./mvnw test)'
                sh '(cd product_service && ./mvnw test)'
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: '**/target/surefire-reports/*.xml'
                }
            }
        }

        stage('Deploy to Production') {
            steps {
                // Securely fetch your .env file from Jenkins Credentials Manager
                withCredentials([file(credentialsId: '01e-com-env-file', variable: 'ENV_FILE')]) {
                    echo 'Deploying to /opt/01e_com...'
                    
                    sh '''
                        mkdir -p ${DEPLOY_DIR}
                        cp docker-compose.yml ${DEPLOY_DIR}/
                        cp "$ENV_FILE" ${DEPLOY_DIR}/.env
                    '''

                    script {
                        try {
                            sh '''
                                cd ${DEPLOY_DIR}
                                ${COMPOSE} up -d --no-build --remove-orphans
                                ${COMPOSE} ps
                            '''
                        } catch (err) {
                            if (!env.GIT_PREVIOUS_SUCCESSFUL_COMMIT) {
                                error 'Deploy failed and no previous successful commit exists. Manual fix required.'
                            }

                            echo "Deploy failed! Rolling back to Git commit: ${env.GIT_PREVIOUS_SUCCESSFUL_COMMIT}"
                            
                            sh '''
                                git checkout ${GIT_PREVIOUS_SUCCESSFUL_COMMIT}
                                cp docker-compose.yml ${DEPLOY_DIR}/
                                ${COMPOSE} build
                                cd ${DEPLOY_DIR}
                                ${COMPOSE} up -d --remove-orphans
                            '''
                            error "Deployment failed. Rolled back to commit ${env.GIT_PREVIOUS_SUCCESSFUL_COMMIT}"
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            // Clean up temporary CI containers & workspace files without stopping production
            sh '${COMPOSE} down --remove-orphans || true'
            cleanWs()
        }

        success {
            echo 'Deployment successful'
            emailext (
                to: env.EMAIL,
                subject: "✅ SUCCESS: ${env.JOB_NAME} [Build #${env.BUILD_NUMBER}]",
                body: "Pipeline completed successfully and deployed to ${env.DEPLOY_DIR}.\n\nLogs: ${env.BUILD_URL}"
            )
        }

        failure {
            echo 'Deployment failed'
            emailext (
                to: env.EMAIL,
                subject: "🚨 FAILURE: ${env.JOB_NAME} [Build #${env.BUILD_NUMBER}]",
                body: "Pipeline or deployment failed. Check logs at: ${env.BUILD_URL}"
            )
        }
    }
}